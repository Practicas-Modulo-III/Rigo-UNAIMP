# true: Groq with mandatory local Ollama fallback. false: fully local Ollama mode.
MODO_DEMO_CLOUD=true

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Oracle A1 Option B uses local ChromaDB, RAM cache and storage on disk.
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIRECTORY=/code/chroma_db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_ENVIRONMENT=

DATABASE_URL=sqlite:///./storage/rigo.db
STORAGE_DIRECTORY=./storage
MAX_UPLOAD_MB=50
ADMIN_USERNAME=admin
# Set a strong password per deployment — never commit the real value.
ADMIN_PASSWORD=changeme-use-a-strong-password

# Generate a unique value per deployment with: openssl rand -hex 32
# Never reuse the value baked into config.py's default or commit the real one here.
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
